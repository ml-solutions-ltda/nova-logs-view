{
    "name": "ml-solutions/nova-logs-view",
    "description": "Read-only Laravel Nova log explorer with filtering, recurring diagnostics and sanitized details.",
    "keywords": [
        "laravel",
        "nova",
        "logs",
        "observability"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^8.83.4 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "laravel/nova": "^3.0 || ^4.0 || ^5.0",
        "illuminate/http": "^8.83.4 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^8.83.4 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/validation": "^8.83.4 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "nesbot/carbon": "^2.62 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "MlSolutions\\NovaLogsView\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MlSolutions\\NovaLogsView\\ToolServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "type": "library",
    "homepage": "https://github.com/ml-solutions-ltda/nova-logs-view",
    "support": {
        "issues": "https://github.com/ml-solutions-ltda/nova-logs-view/issues",
        "source": "https://github.com/ml-solutions-ltda/nova-logs-view"
    }
}
