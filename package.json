{
  "private": true,
  "scripts": {
    "dev": "npm run development",
    "development": "mix",
    "watch": "mix watch",
    "watch-poll": "mix watch -- --watch-options-poll=1000",
    "prod": "npm run production",
    "production": "npm run production:modern && npm run production:legacy",
    "test": "node --test tests/assets/*.test.mjs",
    "production:modern": "mix --production",
    "production:legacy": "npm --prefix build/nova3 run production",
    "install:legacy": "npm --prefix build/nova3 ci"
  },
  "devDependencies": {
    "laravel-mix": "^6.0.49",
    "vue": "^3.5.16",
    "vue-loader": "^17.4.2",
    "@vue/compiler-sfc": "^3.5.16",
    "webpack": "5.99.9",
    "jsdom": "^26.0.0",
    "vue-nova4": "npm:vue@3.2.29"
  },
  "dependencies": {},
  "name": "@ml-solutions/nova-logs-view"
}
